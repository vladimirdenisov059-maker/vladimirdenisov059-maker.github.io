---
import type { Experiment } from '@/data/types';
interface Props { experiment: Experiment; index?: number }
const { experiment, index = 1 } = Astro.props;
---
<article class="experiment-card">
  <span class="experiment-number">{String(index).padStart(2, '0')}</span>
  <div><div class="card-meta"><span>{experiment.status}</span>{experiment.startYear && <span>с {experiment.startYear} года</span>}</div><h2><a href={`/experiments/${experiment.slug}/`}>{experiment.title}</a></h2><p>{experiment.summary}</p><a class="text-link" href={`/experiments/${experiment.slug}/`}>Смотреть дневник <span aria-hidden="true">→</span></a></div>
</article>
