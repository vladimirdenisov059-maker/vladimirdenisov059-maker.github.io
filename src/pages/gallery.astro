  { src:'/images/gallery/garden-2022-08-25.jpg', title:'Архивный снимок, 25 августа 2022', alt:'Архивная фотография из сада Владимира Денисова' },
  { src:'/images/plants/ayva-yaponskaya/ayva-yaponskaya-henomeles.jpg', title:'Айва японская (хеномелес)', alt:'Плоды айвы японской в саду' },
  { src:'/images/plants/boyaryshnik/boyaryshnik-zheltyy-poyarkovoy.jpg', title:'Жёлтый неколючий боярышник Поярковой', alt:'Жёлтые плоды боярышника Поярковой' },
  { src:'/images/plants/boyaryshnik/boyaryshnik-petushya-shpora-i-rozovyy.jpg', title:'Боярышник Петушья шпора и розовый', alt:'Красный и розовый боярышник' },
