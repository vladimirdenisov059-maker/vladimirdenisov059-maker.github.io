  { src:'/images/plants/marakuya-severnaya/pervyy-plod-marakuyi-severnoy.jpg', title:'Первый плод Северной Маракуйи', alt:'Первый плод растения Северная Маракуйя' },
  { src:'/images/plants/persik-solnechnyy-donbass/persik-solnechnyy-donbass.jpg', title:'Персик Солнечный Донбасс', alt:'Плод персика Солнечный Донбасс' },
  { src:'/images/plants/lagenariya/tykva-lagenariya.jpg', title:'Тыква лагенария', alt:'Плод лагенарии в саду' },
