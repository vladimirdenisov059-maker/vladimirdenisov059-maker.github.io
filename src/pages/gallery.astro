  { src:'/images/plants/son-trava/son-trava-belaya.jpg', title:'Сон-трава белая', alt:'Белое цветение сон-травы' },
  { src:'/images/plants/son-trava/son-trava-fioletovaya.jpg', title:'Сон-трава фиолетовая', alt:'Фиолетовое цветение сон-травы' },
  { src:'/images/plants/marakuya-severnaya/cvetok-marakuyi-severnoy.jpg', title:'Цветок Северной Маракуйи', alt:'Цветок растения, которое автор называет Северной Маракуйей' },
  { src:'/images/plants/krasnomyakotnye-yabloni/yabloko-krasnomyakotnoe.jpg', title:'Красномякотное яблоко', alt:'Разрез красномякотного яблока из сада Владимира' },
