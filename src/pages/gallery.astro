  { src:'/images/plants/shelkovica/shelkovica-krupnoplodnaya.jpg', title:'Шелковица крупноплодная', alt:'Плоды крупноплодной шелковицы' },
  { src:'/images/plants/krasnomyakotnye-yabloni/yabloko-krasnomyakotnoe-2.jpg', title:'Красномякотное яблоко — архивный снимок', alt:'Красномякотное яблоко из сада Владимира' },];
const videos = [{ src:'/images/gallery/kivi-2016.mp4', title:'Киви в саду, 2016 год' }];
---
<BaseLayout title="Галерея" description="Фотолетопись сада Владимира Денисова: растения, плоды и эксперименты.">
  <PageHero eyebrow="Фотолетопись" title="Галерея" intro="Оригинальные фотографии из сада Владимира: растения, плоды, цветение и этапы экспериментов." note="Подписи и определения будут уточняться вместе с автором."/>
  <section class="section"><div class="wrap"><div class="gallery-grid">{photos.map((photo,index)=><figure class:list={['gallery-item',{'gallery-item--wide':index===0||index===10}]}><img src={photo.src} alt={photo.alt} loading={index<3?'eager':'lazy'} decoding="async"/><figcaption><h2>{photo.title}</h2><p>Авторская фотография Владимира Денисова.</p></figcaption></figure>)}</div><section class="video-gallery"><h2>Видеоархив</h2>{videos.map((video)=><figure><video controls preload="metadata"><source src={video.src} type="video/mp4"/>Ваш браузер не поддерживает видео.</video><figcaption>{video.title}</figcaption></figure>)}</section></div></section>
</BaseLayout>
<style>.gallery-grid{columns:3 280px;column-gap:1.5rem}.gallery-item{break-inside:avoid;margin:0 0 1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--line)}.gallery-item img{width:100%;height:auto;border-radius:var(--radius);background:var(--paper-2)}.gallery-item h2{margin:.8rem 0 .25rem;font-size:1.2rem}.gallery-item p{margin:0;color:var(--muted);font-size:.8rem}.video-gallery{margin-top:4rem}.video-gallery video{width:min(100%,860px);max-height:70vh;background:#102b20;border-radius:var(--radius)}.video-gallery figure{margin:1.5rem 0}.video-gallery figcaption{margin-top:.6rem;color:var(--muted)}</style>