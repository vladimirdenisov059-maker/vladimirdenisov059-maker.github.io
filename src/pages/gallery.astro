  { src:'/images/plants/kizil/kizil.jpg', title:'Кизил', alt:'Плоды кизила в саду Владимира' },
  { src:'/images/plants/limonnik-kitayskiy/limonnik-kitayskiy.jpg', title:'Китайский лимонник', alt:'Плоды китайского лимонника' },
  { src:'/images/plants/kryzhovnik/kryzhovnik-nekolyuchiy.jpg', title:'Крыжовник неколючий', alt:'Плоды неколючего крыжовника' },
  { src:'/images/plants/krymskie-podsnezhniki/krymskie-podsnezhniki-pod-snegom.jpg', title:'Крымские подснежники под снегом', alt:'Крымские подснежники цветут под снегом' },
