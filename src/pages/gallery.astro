  { src:'/images/plants/pion-drevovidnyy/pion-drevovidnyy-mahrovyy.jpg', title:'Махровый древовидный пион', alt:'Цветок махрового древовидного пиона' },
  { src:'/images/plants/ezhevika/ezhevika-black-gem.jpg', title:'Ежевика Блэк Джем', alt:'Плоды ежевики Блэк Джем' },
  { src:'/images/plants/ezhevika/ezhevika-thornfree.jpg', title:'Ежевика Торнфри', alt:'Плоды ежевики Торнфри' },
