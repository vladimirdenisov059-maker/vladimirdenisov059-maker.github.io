---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhotoPlaceholder from '@/components/PhotoPlaceholder.astro';
import PlantCard from '@/components/PlantCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import ExperimentCard from '@/components/ExperimentCard.astro';
import { plants } from '@/data/plants';
import { articles } from '@/data/articles';
import { experiments } from '@/data/experiments';
import { site } from '@/config/site';

const personLd = { '@context':'https://schema.org', '@type':'Person', name:site.author, url:new URL('/about/', Astro.site ?? Astro.url.origin).href, sameAs:site.social.map((item) => item.url), description:'Садовод-практик из Донбасса с многолетним опытом.' };
---
<BaseLayout jsonLd={personLd}>
  <section class="home-hero">
    <div class="wrap home-hero-grid">
      <div class="hero-copy"><p class="eyebrow">40 лет личных наблюдений</p><h1>Редкие растения.<br/><em>Реальный</em> Донбасс.</h1><p class="lead">Полевой дневник Владимира Денисова — о растениях, которые росли, мёрзли, восстанавливались и плодоносили в настоящем саду.</p><div class="hero-actions"><a class="button" href="/experiments/">Смотреть эксперименты</a><a class="button button--ghost" href="/plants/">Каталог растений</a></div></div>
      <div class="hero-visual"><PhotoPlaceholder ratio="portrait" label="Главная фотография сада" eager /><div class="hero-stamp"><b>40</b><span>лет<br/>в саду</span></div></div>
    </div>
    <div class="wrap hero-foot"><span>Донбасс · личный сад</span><span>Эксперименты без прикрас</span><span>Архив пополняется</span></div>
  </section>

  <section class="section intro-section"><div class="wrap intro-grid"><p class="eyebrow">О проекте</p><h2>Не пересказ чужих советов,<br/>а следы прожитых сезонов</h2><div><p>Здесь будут собраны фотографии, даты, сорта и наблюдения Владимира — вместе с удачами, ошибками и вопросами, на которые сад ещё не ответил.</p><a class="text-link" href="/about/">Познакомиться с автором →</a></div></div></section>

  <section class="section section--dark"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Долгие истории</p><h2>Эксперименты</h2></div><p>Некоторые ответы требуют не одного сезона, а десятилетий наблюдений.</p></div><div class="experiment-list">{experiments.map((experiment,index) => <ExperimentCard experiment={experiment} index={index+1} />)}</div><p style="margin-top:2rem"><a class="button button--light" href="/experiments/">Все эксперименты</a></p></div></section>

  <section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Живая коллекция</p><h2>Растения сада</h2></div><a class="button button--ghost" href="/plants/">Весь каталог</a></div><div class="cards-grid">{plants.slice(0,3).map((plant) => <PlantCard plant={plant} />)}</div></div></section>

  <section class="section season-band"><div class="wrap season-grid"><div><p class="eyebrow">Сезонный ориентир</p><h2>Что происходит<br/>в саду сейчас</h2></div><div class="season-month"><span>07</span><b>Июль</b></div><div><h3>Наблюдаем и фиксируем</h3><p>Подвязка нового прироста, контроль влаги и фотодневник развития плодов. Конкретные работы всегда корректируются по погоде и состоянию растений.</p><a class="text-link" href="/calendar/">Открыть календарь →</a></div></div></section>

  <section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Записи из сада</p><h2>Новые материалы</h2></div><a class="button button--ghost" href="/articles/">Все статьи</a></div><div class="cards-grid">{articles.map((article) => <ArticleCard article={article} />)}</div></div></section>

  <section class="section section--line"><div class="wrap newsletter"><div><p class="eyebrow">Следить за садом</p><h2>Новые наблюдения — по мере сезона</h2><p>Подписка появится после выбора безопасного сервиса. Пока можно следить за Владимиром в социальных сетях.</p></div><div class="social-cta">{site.social.map((item)=><a class="button button--ghost" href={item.url} target="_blank" rel="noopener">{item.label}</a>)}</div></div></section>
</BaseLayout>

<style>
.home-hero{padding:clamp(3rem,8vw,7rem) 0 1.5rem;overflow:hidden;background:linear-gradient(135deg,rgba(216,168,78,.12),transparent 45%)}.home-hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,7vw,7rem);align-items:center}.hero-copy h1{font-size:clamp(3.2rem,8.5vw,7.8rem)}.hero-copy h1 em{color:var(--apple);font-weight:400}.hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.hero-visual{position:relative;max-width:470px;justify-self:end;width:100%;transform:rotate(1.2deg)}.hero-visual::before{content:'';position:absolute;inset:-1rem 1rem 1rem -1rem;border:1px solid var(--forest);z-index:-1}.hero-stamp{position:absolute;left:-3rem;bottom:2rem;display:flex;align-items:center;gap:.5rem;width:118px;height:118px;padding:1rem;border-radius:50%;color:var(--white);background:var(--apple);transform:rotate(-10deg);box-shadow:var(--shadow)}.hero-stamp b{font:600 2.4rem var(--serif)}.hero-stamp span{font-size:.65rem;text-transform:uppercase;line-height:1.2}.hero-foot{display:flex;justify-content:space-between;gap:1rem;margin-top:4rem;padding-top:1rem;border-top:1px solid var(--line);color:var(--muted);font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.intro-grid{display:grid;grid-template-columns:1fr 2fr 1.3fr;gap:3rem;align-items:start}.intro-grid>div{color:var(--muted)}.season-band{background:var(--paper-2)}.season-grid{display:grid;grid-template-columns:1.2fr .7fr 1.4fr;gap:3rem;align-items:center}.season-month{display:grid;place-items:center;aspect-ratio:1;max-width:220px;border:1px solid var(--apple);border-radius:50%;color:var(--apple)}.season-month span{font:600 clamp(3.5rem,8vw,6rem) var(--serif);line-height:.7}.season-month b{text-transform:uppercase;letter-spacing:.12em}.newsletter{display:grid;grid-template-columns:1.6fr 1fr;gap:3rem;align-items:center}.social-cta{display:flex;flex-wrap:wrap;gap:.6rem}@media(max-width:800px){.home-hero-grid,.intro-grid,.season-grid,.newsletter{grid-template-columns:1fr}.hero-visual{max-width:340px;justify-self:center}.hero-stamp{left:-1rem;width:96px;height:96px}.hero-foot{display:none}.intro-grid{gap:1rem}.season-month{max-width:150px}.home-hero{padding-top:2.5rem}}
</style>
