---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import PhotoPlaceholder from '@/components/PhotoPlaceholder.astro'; import { articles } from '@/data/articles';
export function getStaticPaths(){return articles.map((article)=>({params:{slug:article.slug},props:{article}}));} const {article}=Astro.props;
const articleLd={'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.excerpt,author:{'@type':'Person',name:article.author},mainEntityOfPage:Astro.url.href,...(article.publishedAt?{datePublished:article.publishedAt}:{})};
---
<BaseLayout title={article.title} description={article.excerpt} type="article" jsonLd={articleLd}><div class="reading-progress" aria-hidden="true"></div><Breadcrumbs items={[{label:'Главная',href:'/'},{label:'Статьи',href:'/articles/'},{label:article.title}]}/><article><header class="article-header wrap"><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="lead">{article.excerpt}</p><div class="byline"><span>{article.author}</span><span>{article.readingTime} мин чтения</span>{article.publishedAt&&<time datetime={article.publishedAt}>{article.publishedAt}</time>}</div></header><div class="wrap article-cover"><PhotoPlaceholder label={`Обложка: ${article.title}`} image={article.coverImage} alt={article.coverImage?article.title:''}/></div><section class="section"><div class="wrap article-layout"><div class="prose">{article.content.map((paragraph,index)=><p class:list={{'prose-intro':index===0}}>{paragraph}</p>)}<div class="notice"><strong>Статус материала</strong>Демонстрационное наполнение подготовлено только из сведений ТЗ. Перед публикацией текст должен проверить Владимир Денисов.</div>{article.originalUrl&&<p>Источник: <a href={article.originalUrl}>{article.originalSource??'исходная публикация'}</a></p>}</div><aside class="article-aside"><h2>Темы</h2><ul class="tag-list">{article.tags.map((tag)=><li>{tag}</li>)}</ul><p><a class="text-link" href="/articles/">← Все статьи</a></p></aside></div></section></article></BaseLayout>
<style>.article-header{max-width:980px;padding:clamp(3rem,8vw,6rem) 0 2rem}.article-header h1{font-size:clamp(2.7rem,7vw,6.5rem)}.byline{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:2rem;color:var(--muted);font-size:.8rem}.article-cover{max-width:1180px}.article-cover .photo{aspect-ratio:2/1}.reading-progress{position:fixed;top:0;left:0;z-index:100;width:0;height:4px;background:var(--apple)}</style><script>const bar=document.querySelector<HTMLElement>('.reading-progress');const update=()=>{const max=document.documentElement.scrollHeight-innerHeight;if(bar)bar.style.width=`${max>0?(scrollY/max)*100:0}%`};addEventListener('scroll',update,{passive:true});update();</script>
