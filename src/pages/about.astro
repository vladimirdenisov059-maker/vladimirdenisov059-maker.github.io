---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import PhotoPlaceholder from '@/components/PhotoPlaceholder.astro'; import { site } from '@/config/site';
---
<BaseLayout title="Об авторе" description="Владимир Денисов — садовод-практик из Донбасса, около 40 лет наблюдающий плодовые, ягодные и редкие культуры."><PageHero eyebrow="Человек за дневником" title="Владимир Денисов" intro="Садовод-практик из Донбасса, около сорока лет работающий с плодовыми, ягодными, экзотическими и редкими растениями." note="Главный источник сайта — собственный сад, записи, фотографии и память автора."/><section class="section"><div class="wrap about-grid"><PhotoPlaceholder ratio="portrait" label="Портрет Владимира Денисова" image="/images/author/vladimir-denisov.jpg" alt="Владимир Денисов" eager/><div class="prose"><h2>Опыт, выросший вместе с садом</h2><p class="prose-intro">Владимир занимается садоводством как увлечённый практик. Ценность проекта — не формальная биография, а многолетняя последовательность собственных опытов.</p><p>В саду растут привычные и редкие для региона культуры: от ежевики и яблонь до актинидии, киви, хурмы и пекана. Некоторые истории уже длятся более двадцати лет.</p><p>Сайт будет постепенно наполняться первичными материалами автора. Мы не добавляем недоказанные температурные пределы, урожайность и сортовые характеристики.</p><h2>Где читать сейчас</h2><div class="social-row">{site.social.map((item)=><a class="button button--ghost" href={item.url} target="_blank" rel="noopener">{item.label}</a>)}</div></div></div></section></BaseLayout>
<style>.about-grid{display:grid;grid-template-columns:minmax(260px,.65fr) 1.2fr;gap:clamp(2rem,8vw,8rem);align-items:start}.about-grid .photo{max-width:430px}.social-row{display:flex;flex-wrap:wrap;gap:.6rem}@media(max-width:720px){.about-grid{grid-template-columns:1fr}}</style>
