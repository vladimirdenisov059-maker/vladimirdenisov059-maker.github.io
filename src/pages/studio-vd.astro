  .studio-step h2{margin-bottom:1rem;font-size:clamp(1.4rem,3vw,2rem)}.studio-step label{display:block;margin:.8rem 0 .45rem;color:var(--forest);font-weight:700}
  .studio-step input[type="text"],.studio-step input[type="password"],.studio-step input[type="datetime-local"],.studio-step textarea{width:100%;padding:.8rem 1rem;border:1px solid var(--line);border-radius:14px;color:var(--ink);background:var(--paper);font:inherit;line-height:1.55}
  .studio-step textarea{resize:vertical}.studio-step input:focus,.studio-step textarea:focus{outline:3px solid rgba(216,168,78,.4);border-color:var(--forest)}
  .field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.field-help,.editor-meta,.draft-source{color:var(--muted);font-size:.82rem}.studio-step .button{margin-top:1rem}
  .studio-status{min-height:1.5em;margin:.8rem 0 0;color:var(--forest)}.studio-status[data-error="true"]{color:var(--apple)}.editor-meta{display:flex;justify-content:space-between;gap:1rem;margin-top:.5rem}
  .button-row{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1rem}.secondary-button,.file-picker,.remove-media{padding:.65rem 1rem;border:1px solid var(--forest);border-radius:999px;color:var(--forest);background:transparent;cursor:pointer;font-weight:700}
  .file-picker{display:inline-block!important;margin-top:.5rem!important}#vk-media{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .media-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-top:1rem}.media-card{overflow:hidden;border:1px solid var(--line);border-radius:14px;background:var(--paper)}
