---
import BaseLayout from '@/layouts/BaseLayout.astro';

const publicGeneratorUrl = import.meta.env.PUBLIC_GENERATOR_API_URL || '/api/generate-post';
const apiOrigin = publicGeneratorUrl.startsWith('http') ? new URL(publicGeneratorUrl).origin : '';
const draftEndpoint = `${apiOrigin}/api/owner/generate-vk`;
const publishEndpoint = `${apiOrigin}/api/owner/publish-vk`;
const statusEndpoint = `${apiOrigin}/api/owner/vk-status`;
const uploadEndpoint = `${apiOrigin}/api/owner/upload-vk-media`;
const historyEndpoint = `${apiOrigin}/api/owner/publication-history`;
---

<BaseLayout title="Редактор Владимира" description="Закрытый редактор авторских публикаций Владимира Денисова.">
  <section class="section owner-studio">
    <div class="wrap studio-wrap">
      <header class="studio-heading">
        <p class="eyebrow">Личный кабинет</p>
        <h1>Редактор постов Владимира</h1>
        <p>Здесь готовится подробный пост для личной страницы ВКонтакте. Действия защищены паролем владельца.</p>
      </header>

      <div class="privacy-note" role="note">
        <strong>Как это работает:</strong> создайте черновик, исправьте текст, добавьте фотографии или видео, выберите публикацию сейчас либо по расписанию и только затем подтвердите отправку.
      </div>

      <form class="studio-card access-card" data-owner-form data-draft-endpoint={draftEndpoint} data-publish-endpoint={publishEndpoint} data-status-endpoint={statusEndpoint} data-upload-endpoint={uploadEndpoint} data-history-endpoint={historyEndpoint}>
        <section class="studio-step" aria-labelledby="step-access">
          <div class="step-number">Доступ</div>
          <h2 id="step-access">Пароль владельца</h2>
          <label for="owner-password">Введите пароль закрытого редактора</label>
          <input id="owner-password" name="password" type="password" autocomplete="current-password" minlength="12" required />
          <p class="field-help">Пароль проверяется в Cloudflare и не записывается на сайт.</p>
          <div class="vk-connect-panel">
            <p data-vk-state>Запускаем приложение ВКонтакте…</p>
            <button class="secondary-button" type="button" data-vk-connect disabled>Подключить мою страницу ВК</button>
            <p class="field-help">ВКонтакте сам покажет запрашиваемые разрешения. Ключ доступа не сохраняется на сайте.</p>
          </div>
        </section>

        <section class="studio-step" aria-labelledby="step-one">
          <div class="step-number">Шаг 1</div>
          <h2 id="step-one">Создать подробный пост для ВК</h2>
          <div class="field-grid">
            <div>
              <label for="owner-plant">Растение</label>
              <input id="owner-plant" name="plant" type="text" minlength="2" maxlength="80" placeholder="Например: киви Стратона" required />
            </div>
            <div>
              <label for="owner-focus">Главная тема поста</label>
              <input id="owner-focus" name="focus" type="text" maxlength="500" placeholder="Например: первое цветение и история опыта" />
            </div>
          </div>
          <label for="owner-notes">Мои наблюдения, которые обязательно учесть</label>
          <textarea id="owner-notes" name="notes" rows="5" maxlength="3000" placeholder="Добавьте новые факты, которых ещё нет на сайте. Если растение уже подробно описано, поле можно оставить пустым."></textarea>
          <p class="field-help">Эти сведения будут переданы сервису искусственного интеллекта только для создания черновика.</p>
          <button class="button" type="submit" data-generate-button>Создать черновик от моего имени</button>
          <p class="studio-status" data-studio-status aria-live="polite"></p>
        </section>
      </form>

      <section class="studio-card studio-step" data-editor-section hidden aria-labelledby="step-two">
        <div class="step-number">Шаг 2</div>
        <h2 id="step-two">Проверить и исправить текст</h2>
        <p class="draft-source" data-draft-source></p>
        <label for="vk-draft">Текст поста</label>
        <textarea id="vk-draft" rows="22" maxlength="15000" data-vk-draft></textarea>
        <div class="editor-meta">
          <span data-character-count>0 знаков</span>
          <span>Изменения остаются только на этом устройстве</span>
        </div>
        <div class="button-row">
          <button class="secondary-button" type="button" data-copy-draft>Копировать</button>
          <button class="secondary-button" type="button" data-download-draft>Сохранить как TXT</button>
        </div>
      </section>

      <section class="studio-card studio-step" data-media-section hidden aria-labelledby="step-three">
        <div class="step-number">Шаг 3</div>
        <h2 id="step-three">Добавить фотографии и видео</h2>
        <p>Можно выбрать до 10 файлов. Фотографии: JPG, PNG или WebP до 25 МБ. Видео: MP4, WebM, MOV или MKV до 95 МБ.</p>
        <label class="file-picker" for="vk-media">Выбрать фото или видео</label>
        <input id="vk-media" type="file" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime,video/x-matroska" multiple data-media-input />
        <div class="media-grid" data-media-list></div>
        <p class="studio-status" data-media-status aria-live="polite"></p>
      </section>

      <section class="studio-card studio-step publish-step" data-publish-section hidden aria-labelledby="step-four">
        <div class="step-number">Шаг 4</div>
        <h2 id="step-four">Выбрать время, одобрить и отправить</h2>
        <p>Перед отправкой убедитесь, что выше указана именно ваша личная страница ВКонтакте.</p>

        <fieldset class="publish-mode">
          <legend>Когда опубликовать</legend>
          <label><input type="radio" name="publish-mode" value="now" checked data-publish-mode /> Сразу после подтверждения</label>
          <label><input type="radio" name="publish-mode" value="scheduled" data-publish-mode /> В выбранные дату и время</label>
        </fieldset>
        <div data-schedule-fields hidden>
          <label for="publish-date">Дата и время публикации</label>
          <input id="publish-date" type="datetime-local" data-publish-date />
          <p class="field-help">После постановки в очередь компьютер можно выключить: запись опубликует сам ВКонтакте.</p>
        </div>

        <label class="approval-row">
          <input type="checkbox" data-publish-approval />
          <span>Я проверил текст, вложения, дату и время и одобряю публикацию на моей личной странице ВКонтакте.</span>
        </label>
        <button class="button publish-button" type="button" data-publish-button disabled>Опубликовать сейчас</button>
        <p class="studio-status" data-publish-status aria-live="polite"></p>
        <p data-published-link></p>
      </section>

      <section class="studio-card studio-step history-step" aria-labelledby="publication-history">
        <div class="step-number">История</div>
        <h2 id="publication-history">История публикаций</h2>
        <p>Хранятся только дата, площадка, название, статус и ссылка. Тексты постов, фотографии и видео здесь не сохраняются.</p>
        <button class="secondary-button" type="button" data-history-refresh>Обновить историю</button>
        <p class="studio-status" data-history-status aria-live="polite">Введите пароль владельца и нажмите «Обновить историю».</p>
        <div class="history-list" data-history-list></div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import bridge from '@vkontakte/vk-bridge';

  const VK_APP_ID = 54704308;
  const VK_APP_URL = 'https://vk.ru/app54704308';
  const vkLaunchParams = new URLSearchParams(window.location.search);
  const isVkMiniApp = vkLaunchParams.has('vk_app_id') || vkLaunchParams.has('vk_user_id') || vkLaunchParams.has('vk_platform');
  const form = document.querySelector<HTMLFormElement>('[data-owner-form]');
  const passwordInput = document.querySelector<HTMLInputElement>('#owner-password');
  const plantInput = document.querySelector<HTMLInputElement>('#owner-plant');
  const focusInput = document.querySelector<HTMLInputElement>('#owner-focus');
  const notesInput = document.querySelector<HTMLTextAreaElement>('#owner-notes');
  const generateButton = document.querySelector<HTMLButtonElement>('[data-generate-button]');
  const status = document.querySelector<HTMLElement>('[data-studio-status]');
  const editorSection = document.querySelector<HTMLElement>('[data-editor-section]');
  const mediaSection = document.querySelector<HTMLElement>('[data-media-section]');
  const publishSection = document.querySelector<HTMLElement>('[data-publish-section]');
  const draft = document.querySelector<HTMLTextAreaElement>('[data-vk-draft]');
  const draftSource = document.querySelector<HTMLElement>('[data-draft-source]');
  const characterCount = document.querySelector<HTMLElement>('[data-character-count]');
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-draft]');
  const downloadButton = document.querySelector<HTMLButtonElement>('[data-download-draft]');
  const mediaInput = document.querySelector<HTMLInputElement>('[data-media-input]');
  const mediaList = document.querySelector<HTMLElement>('[data-media-list]');
  const mediaStatus = document.querySelector<HTMLElement>('[data-media-status]');
  const scheduleFields = document.querySelector<HTMLElement>('[data-schedule-fields]');
  const publishDate = document.querySelector<HTMLInputElement>('[data-publish-date]');
  const publishModes = [...document.querySelectorAll<HTMLInputElement>('[data-publish-mode]')];
  const approval = document.querySelector<HTMLInputElement>('[data-publish-approval]');
  const publishButton = document.querySelector<HTMLButtonElement>('[data-publish-button]');
  const publishStatus = document.querySelector<HTMLElement>('[data-publish-status]');
  const vkState = document.querySelector<HTMLElement>('[data-vk-state]');
  const vkConnectButton = document.querySelector<HTMLButtonElement>('[data-vk-connect]');
  const publishedLink = document.querySelector<HTMLElement>('[data-published-link]');
  const historyRefresh = document.querySelector<HTMLButtonElement>('[data-history-refresh]');
  const historyStatus = document.querySelector<HTMLElement>('[data-history-status]');
  const historyList = document.querySelector<HTMLElement>('[data-history-list]');

  type MediaItem = { id: string; file: File; previewUrl: string };
  type VkUploadServer = { upload_url?: string };
  type VkPhotoUploadResult = { server?: number; photo?: string; hash?: string };
  type VkSavedPhoto = { id?: number; owner_id?: number; access_key?: string };
  type VkSavedVideo = VkUploadServer & { video_id?: number; owner_id?: number; access_key?: string };
  type HistoryEntry = { id: string; platform: 'vk' | 'ok' | 'dzen'; title: string; status: 'published' | 'scheduled' | 'error'; createdAt: string; scheduledAt?: string; url?: string };
  let mediaItems: MediaItem[] = [];
  const uploadedAttachments = new Map<string, string>();
  let vkConfigured = false;
  let vkAccessToken = '';
  let vkOwnerId: number | null = null;
  let vkBridgeReady = false;
  let busy = false;
  let publishRequestId = crypto.randomUUID();

  const setStatus = (node: HTMLElement | null, message: string, isError = false) => {
    if (!node) return;
    node.textContent = message;
    node.dataset.error = String(isError);
  };

  const selectedMode = () => publishModes.find((item) => item.checked)?.value ?? 'now';
  const resetApproval = (message = 'После изменений снова отметьте подтверждение.') => {
    if (approval) approval.checked = false;
    publishRequestId = crypto.randomUUID();
    updatePublishButton();
    setStatus(publishStatus, message);
    publishedLink?.replaceChildren();
  };
  const updateCounter = () => {
    if (characterCount) characterCount.textContent = `${draft?.value.length ?? 0} знаков`;
  };
  const updatePublishButton = () => {
    if (!publishButton) return;
    const scheduledReady = selectedMode() === 'now' || Boolean(publishDate?.value);
    publishButton.disabled = busy || !vkConfigured || !approval?.checked || !scheduledReady || (draft?.value.trim().length ?? 0) < 100;
    publishButton.textContent = selectedMode() === 'scheduled' ? 'Поставить в очередь ВК' : 'Опубликовать сейчас';
  };
  const localDateTimeValue = (date: Date) => {
    const pad = (value: number) => String(value).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  };
  const updateScheduleMinimum = () => {
    if (!publishDate) return;
    publishDate.min = localDateTimeValue(new Date(Date.now() + 5 * 60 * 1000));
    if (!publishDate.value) publishDate.value = localDateTimeValue(new Date(Date.now() + 30 * 60 * 1000));
  };

  const renderMedia = () => {
    if (!mediaList) return;
    mediaList.replaceChildren();
    mediaItems.forEach((item, index) => {
      const card = document.createElement('article');
      card.className = 'media-card';
      const preview = item.file.type.startsWith('image/') ? document.createElement('img') : document.createElement('video');
      preview.src = item.previewUrl;
      if (preview instanceof HTMLVideoElement) preview.controls = true;
      preview.setAttribute('aria-label', item.file.name);
      const info = document.createElement('div');
      info.className = 'media-info';
      const name = document.createElement('strong');
      name.textContent = `${index + 1}. ${item.file.name}`;
      const size = document.createElement('span');
      size.textContent = `${(item.file.size / 1024 / 1024).toFixed(1)} МБ`;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'remove-media';
      remove.textContent = 'Убрать';
      remove.addEventListener('click', () => {
        URL.revokeObjectURL(item.previewUrl);
        mediaItems = mediaItems.filter((candidate) => candidate.id !== item.id);
        uploadedAttachments.delete(item.id);
        renderMedia();
        resetApproval();
      });
      info.append(name, size, remove);
      card.append(preview, info);
      mediaList.append(card);
    });
    setStatus(mediaStatus, mediaItems.length ? `Выбрано файлов: ${mediaItems.length}. Они загрузятся во ВКонтакте только после вашего подтверждения.` : 'Вложения не выбраны. Можно опубликовать только текст.');
  };

  const ownerHeaders = (password: string, json = false) => {
    const headers: Record<string, string> = { Authorization: `Bearer ${password}` };
    if (json) headers['Content-Type'] = 'application/json';
    if (vkAccessToken) headers['X-VK-Access-Token'] = vkAccessToken;
    return headers;
  };

  const platformLabels = { vk: 'ВКонтакте', ok: 'Одноклассники', dzen: 'Дзен' };
  const statusLabels = { published: 'Опубликовано', scheduled: 'В очереди', error: 'Ошибка' };
  const formatHistoryDate = (value?: string) => value ? new Date(value).toLocaleString('ru-RU') : '—';
  const renderHistory = (entries: HistoryEntry[]) => {
    if (!historyList) return;
    historyList.replaceChildren();
    if (!entries.length) { const empty = document.createElement('p'); empty.className = 'history-empty'; empty.textContent = 'Публикаций пока нет.'; historyList.append(empty); return; }
    const table = document.createElement('table'); table.className = 'history-table';
    const head = document.createElement('thead'); head.innerHTML = '<tr><th>Дата и время</th><th>Площадка</th><th>Материал</th><th>Статус</th><th>Ссылка</th></tr>';
    const body = document.createElement('tbody');
    entries.forEach((entry) => {
      const row = document.createElement('tr');
      const date = document.createElement('td'); date.textContent = entry.status === 'scheduled' ? formatHistoryDate(entry.scheduledAt) : formatHistoryDate(entry.createdAt);
      const platform = document.createElement('td'); platform.textContent = platformLabels[entry.platform];
      const title = document.createElement('td'); title.textContent = entry.title;
      const state = document.createElement('td'); state.textContent = statusLabels[entry.status]; state.dataset.historyStatus = entry.status;
      const destination = document.createElement('td');
      if (entry.url) { const link = document.createElement('a'); link.href = entry.url; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = 'Открыть'; destination.append(link); } else destination.textContent = '—';
      row.append(date, platform, title, state, destination); body.append(row);
    });
    table.append(head, body); historyList.append(table);
  };
  const historyRequest = async (action: 'list' | 'add', entry?: HistoryEntry) => {
    const password = passwordInput?.value ?? '';
    if (password.length < 12) throw new Error('Введите пароль владельца, чтобы открыть историю.');
    const response = await fetch(form?.dataset.historyEndpoint || '/api/owner/publication-history', { method: 'POST', headers: ownerHeaders(password, true), body: JSON.stringify({ action, ...(entry ? { entry } : {}) }) });
    const data = await response.json() as { entries?: HistoryEntry[]; saved?: boolean; error?: string };
    if (!response.ok) throw new Error(data.error || 'Не удалось открыть историю публикаций.');
    return data;
  };
  const loadHistory = async () => {
    if (historyRefresh) historyRefresh.disabled = true; setStatus(historyStatus, 'Загружаем историю публикаций…');
    try { const data = await historyRequest('list'); renderHistory(data.entries ?? []); setStatus(historyStatus, data.entries?.length ? 'Записей в истории: ' + data.entries.length + '.' : 'История пока пуста.'); }
    catch (error) { setStatus(historyStatus, error instanceof Error ? error.message : 'Не удалось открыть историю публикаций.', true); }
    finally { if (historyRefresh) historyRefresh.disabled = false; }
  };
  const saveHistory = async (entry: HistoryEntry) => {
    try { await historyRequest('add', entry); await loadHistory(); }
    catch (error) { setStatus(historyStatus, error instanceof Error ? error.message : 'Не удалось сохранить запись в истории.', true); }
  };
  historyRefresh?.addEventListener('click', () => void loadHistory());
  const callVkThroughBridge = async <T,>(method: string, parameters: Record<string, string | number> = {}) => {
    if (!vkAccessToken || !vkBridgeReady) throw new Error('Сначала подключите свою страницу ВК.');
    const result = await bridge.send('VKWebAppCallAPIMethod', {
      method,
      params: { ...parameters, access_token: vkAccessToken, v: '5.199' },
    });
    return result.response as T;
  };
  const requestVkAccessToken = async () => {
    if (!vkBridgeReady) throw new Error('Приложение ВКонтакте ещё не готово.');
    const result = await bridge.send('VKWebAppGetAuthToken', {
      app_id: VK_APP_ID,
      scope: 'wall,photos,video',
    });
    if (!result.access_token) throw new Error('ВКонтакте не выдал ключ доступа.');
    vkAccessToken = result.access_token;
    return vkAccessToken;
  };

  const checkVkConnection = async (password: string) => {
    try {
      if (vkAccessToken && vkBridgeReady) {
        const users = await callVkThroughBridge<Array<{ id: number; first_name?: string; last_name?: string }>>('users.get', { fields: 'screen_name' });
        const user = users[0];
        if (!user?.id) throw new Error('ВКонтакте не вернул данные страницы.');
        vkOwnerId = user.id;
        vkConfigured = true;
        const name = [user.first_name, user.last_name].filter(Boolean).join(' ').trim();
        if (vkState) vkState.textContent = `Подключена личная страница ВК: ${name || `ID ${user.id}`}.`;
      } else {
        if (!form?.dataset.statusEndpoint) return;
        const response = await fetch(form.dataset.statusEndpoint, { method: 'POST', headers: ownerHeaders(password) });
        const data = await response.json() as { configured?: boolean; ownerId?: number; name?: string; error?: string };
        vkConfigured = response.ok && data.configured === true;
        vkOwnerId = data.ownerId || null;
        if (vkState) vkState.textContent = vkConfigured
          ? `Подключена личная страница ВК: ${data.name || 'владелец'}.`
          : (data.error || 'ВКонтакте пока не подключён.');
      }
    } catch {
      vkConfigured = false;
      vkOwnerId = null;
      if (vkState) vkState.textContent = 'ВКонтакте не подтвердил доступ. Нажмите «Подключить мою страницу ВК» ещё раз.';
    }
    updatePublishButton();
  };

  const initializeVkMiniApp = async () => {
    if (!isVkMiniApp) {
      if (vkState) vkState.textContent = 'На сайте можно создавать и исправлять черновики. Для публикации откройте этот же редактор внутри ВКонтакте.';
      if (vkConnectButton) {
        vkConnectButton.disabled = false;
        vkConnectButton.textContent = 'Открыть редактор во ВКонтакте';
      }
      return;
    }
    try {
      await Promise.race([
        bridge.send('VKWebAppInit'),
        new Promise<never>((_, reject) => window.setTimeout(() => reject(new Error('VK Mini App timeout')), 5000)),
      ]);
      vkBridgeReady = true;
      if (vkConnectButton) vkConnectButton.disabled = false;
      if (vkState) vkState.textContent = 'Приложение ВК запущено. Нажмите кнопку ниже, чтобы подключить свою страницу.';
    } catch {
      if (vkConnectButton) vkConnectButton.disabled = false;
      if (vkState) vkState.textContent = 'ВКонтакте не ответил. Перезагрузите приложение и повторите подключение.';
    }
  };

  vkConnectButton?.addEventListener('click', async () => {
    if (!isVkMiniApp) {
      window.open(VK_APP_URL, '_blank', 'noopener,noreferrer');
      return;
    }
    const password = passwordInput?.value ?? '';
    if (password.length < 12) return setStatus(vkState, 'Сначала введите пароль владельца.', true);
    if (!vkBridgeReady) return setStatus(vkState, 'Откройте редактор через приложение ВКонтакте и повторите.', true);
    vkConnectButton.disabled = true;
    setStatus(vkState, 'ВКонтакте запрашивает разрешения на стену, фото и видео…');
    try {
      await requestVkAccessToken();
      await checkVkConnection(password);
    } catch {
      vkAccessToken = '';
      vkConfigured = false;
      setStatus(vkState, 'Подключение не завершено. Разрешите доступ в окне ВКонтакте и повторите.', true);
      updatePublishButton();
    } finally {
      vkConnectButton.disabled = false;
    }
  });

  draft?.addEventListener('input', () => { updateCounter(); resetApproval(); });
  approval?.addEventListener('change', updatePublishButton);
  publishModes.forEach((mode) => mode.addEventListener('change', () => {
    if (scheduleFields) scheduleFields.hidden = selectedMode() !== 'scheduled';
    updateScheduleMinimum();
    resetApproval('Проверьте выбранный режим публикации и подтвердите его.');
  }));
  publishDate?.addEventListener('change', () => resetApproval('Проверьте новую дату и снова подтвердите публикацию.'));

  mediaInput?.addEventListener('change', () => {
    const incoming = [...(mediaInput.files ?? [])];
    const errors: string[] = [];
    incoming.forEach((file) => {
      if (mediaItems.length >= 10) return errors.push('Можно добавить не более 10 файлов.');
      const isPhoto = file.type.startsWith('image/');
      const isVideo = file.type.startsWith('video/');
      if (!isPhoto && !isVideo) return errors.push(`${file.name}: неподдерживаемый формат.`);
      const limit = isPhoto ? 25 * 1024 * 1024 : 95 * 1024 * 1024;
      if (file.size > limit) return errors.push(`${file.name}: файл слишком большой.`);
      const key = `${file.name}:${file.size}:${file.lastModified}`;
      if (mediaItems.some((item) => item.id === key)) return;
      mediaItems.push({ id: key, file, previewUrl: URL.createObjectURL(file) });
    });
    mediaInput.value = '';
    renderMedia();
    resetApproval();
    if (errors.length) setStatus(mediaStatus, errors.join(' '), true);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const password = passwordInput?.value ?? '';
    const plant = plantInput?.value.trim() ?? '';
    if (password.length < 12) return setStatus(status, 'Введите пароль владельца длиной не менее 12 символов.', true);
    if (plant.length < 2) return setStatus(status, 'Введите название растения.', true);
    if (generateButton) { generateButton.disabled = true; generateButton.textContent = 'Создаём подробный черновик…'; }
    setStatus(status, 'Собираем ваш опыт и готовим текст для ВКонтакте…');
    if (editorSection) editorSection.hidden = true;
    if (mediaSection) mediaSection.hidden = true;
    if (publishSection) publishSection.hidden = true;
    try {
      const response = await fetch(form.dataset.draftEndpoint || '/api/owner/generate-vk', {
        method: 'POST',
        headers: ownerHeaders(password, true),
        body: JSON.stringify({ plant, focus: focusInput?.value ?? '', notes: notesInput?.value ?? '' }),
      });
      const data = await response.json() as { post?: string; error?: string; matchedPlant?: string | null; vkConfigured?: boolean };
      if (!response.ok || !data.post) throw new Error(data.error || 'Не удалось создать черновик.');
      if (draft) draft.value = data.post;
      if (draftSource) draftSource.textContent = data.matchedPlant ? `Использован опубликованный опыт: ${data.matchedPlant}` : 'Черновик создан по добавленным вами наблюдениям.';
      if (!vkAccessToken) vkConfigured = data.vkConfigured === true;
      if (approval) approval.checked = false;
      publishRequestId = crypto.randomUUID();
      updateCounter(); updateScheduleMinimum(); updatePublishButton(); renderMedia();
      if (editorSection) editorSection.hidden = false;
      if (mediaSection) mediaSection.hidden = false;
      if (publishSection) publishSection.hidden = false;
      setStatus(status, 'Черновик готов. Теперь внимательно проверьте и исправьте его.');
      if (vkAccessToken || vkConfigured) await checkVkConnection(password);
      else if (vkState) vkState.textContent = 'Нажмите «Подключить мою страницу ВК». Черновик уже можно исправлять, сохранять и копировать.';
      editorSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (error) {
      setStatus(status, error instanceof Error ? error.message : 'Произошла ошибка.', true);
    } finally {
      if (generateButton) { generateButton.disabled = false; generateButton.textContent = 'Создать черновик от моего имени'; }
    }
  });

  copyButton?.addEventListener('click', async () => {
    const text = draft?.value.trim() ?? '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copyButton.textContent = 'Скопировано';
      window.setTimeout(() => { copyButton.textContent = 'Копировать'; }, 1800);
    } catch { setStatus(publishStatus, 'Не удалось скопировать автоматически. Выделите текст вручную.', true); }
  });
  downloadButton?.addEventListener('click', () => {
    const text = draft?.value.trim() ?? '';
    if (!text) return;
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url; link.download = `post-vk-${new Date().toISOString().slice(0, 10)}.txt`; link.click();
    URL.revokeObjectURL(url);
  });

  const russianError = (error: unknown, fallback: string) => {
    const message = error instanceof Error ? error.message.trim() : '';
    if (!message || /failed to fetch|load failed|networkerror|network request failed/i.test(message) || !/[А-ЯЁа-яё]/.test(message)) return fallback;
    return message;
  };

  const readApiJson = async <T,>(response: Response, fallback: string): Promise<T> => {
    try {
      return await response.json() as T;
    } catch {
      throw new Error(response.ok ? fallback : `Сервис публикации вернул ошибку ${response.status}. Попробуйте ещё раз позже.`);
    }
  };

  const uploadMedia = async (password: string) => {
    const attachments: string[] = [];
    for (let index = 0; index < mediaItems.length; index += 1) {
      const item = mediaItems[index];
      const cached = uploadedAttachments.get(item.id);
      if (cached) { attachments.push(cached); continue; }
      const kind = item.file.type.startsWith('image/') ? 'photo' : 'video';
      setStatus(mediaStatus, `Загружаем во ВКонтакте файл ${index + 1} из ${mediaItems.length}: ${item.file.name}`);
      let attachment: string;
      try {
        let bridgeUploadUrl = '';
        let bridgeVideo: VkSavedVideo | null = null;
        if (vkAccessToken && vkBridgeReady && vkOwnerId) {
          if (kind === 'photo') {
            const server = await callVkThroughBridge<VkUploadServer>('photos.getWallUploadServer');
            if (!server.upload_url) throw new Error('ВКонтакте не выдал адрес для загрузки фотографии.');
            bridgeUploadUrl = server.upload_url;
          } else {
            bridgeVideo = await callVkThroughBridge<VkSavedVideo>('video.save', {
              name: item.file.name.replace(/\.[^.]+$/, '').slice(0, 128) || 'Видео из сада Владимира Денисова',
              wallpost: 0,
            });
            if (!bridgeVideo.upload_url || !bridgeVideo.video_id || !bridgeVideo.owner_id || bridgeVideo.owner_id !== vkOwnerId) {
              throw new Error('ВКонтакте не подготовил загрузку видео.');
            }
            bridgeUploadUrl = bridgeVideo.upload_url;
          }
        }

        const body = new FormData();
        const extension = item.file.name.split('.').pop()?.toLowerCase().replace(/[^a-z0-9]/g, '') || (kind === 'photo' ? 'jpg' : 'mp4');
        body.append(kind === 'photo' ? 'photo' : 'video_file', item.file, `garden-${kind}.${extension}`);
        const headers: Record<string, string> = {
          ...ownerHeaders(password),
          'X-File-Size': String(item.file.size),
          'X-File-Type': item.file.type,
          'X-Video-Title': encodeURIComponent(item.file.name.replace(/\.[^.]+$/, '')),
          ...(bridgeUploadUrl ? { 'X-VK-Upload-URL': bridgeUploadUrl } : {}),
        };
        if (bridgeUploadUrl) delete headers['X-VK-Access-Token'];
        const response = await fetch(`${form?.dataset.uploadEndpoint || '/api/owner/upload-vk-media'}?kind=${kind}`, {
          method: 'POST', headers, body,
        });
        const data = await readApiJson<{ uploaded?: boolean; attachment?: string; uploadResult?: VkPhotoUploadResult; error?: string }>(response, `Не удалось прочитать ответ после загрузки файла «${item.file.name}».`);
        if (!response.ok || !data.uploaded) throw new Error(data.error || `Не удалось загрузить ${item.file.name}.`);

        if (bridgeUploadUrl && kind === 'photo') {
          const uploadResult = data.uploadResult;
          if (!uploadResult?.photo || !uploadResult.hash || uploadResult.server === undefined) throw new Error('ВКонтакте не подтвердил загрузку фотографии.');
          const saved = await callVkThroughBridge<VkSavedPhoto[]>('photos.saveWallPhoto', {
            user_id: Number(vkOwnerId),
            photo: uploadResult.photo,
            server: uploadResult.server,
            hash: uploadResult.hash,
          });
          const photo = saved[0];
          if (!photo?.id || !photo.owner_id || photo.owner_id !== vkOwnerId) throw new Error('ВКонтакте не сохранил фотографию.');
          attachment = `photo${photo.owner_id}_${photo.id}${photo.access_key ? `_${photo.access_key}` : ''}`;
        } else if (bridgeUploadUrl && bridgeVideo) {
          attachment = `video${bridgeVideo.owner_id}_${bridgeVideo.video_id}${bridgeVideo.access_key ? `_${bridgeVideo.access_key}` : ''}`;
        } else {
          if (!data.attachment) throw new Error(data.error || `Не удалось загрузить ${item.file.name}.`);
          attachment = data.attachment;
        }
      } catch (error) {
        const uploadedCount = attachments.length;
        const detail = russianError(error, 'Нет связи с защищённым сервисом загрузки. Проверьте интернет и повторите попытку.');
        setStatus(mediaStatus, `Файл «${item.file.name}» не загружен. ${detail}`, true);
        throw new Error(`Публикация остановлена на загрузке вложений: файл «${item.file.name}» не загружен. ${detail} ${uploadedCount ? `До сбоя загружено файлов: ${uploadedCount}. ` : ''}Пост не создан и не поставлен в очередь.`, { cause: error });
      }
      uploadedAttachments.set(item.id, attachment);
      attachments.push(attachment);
    }
    if (mediaItems.length) setStatus(mediaStatus, `Все вложения загружены во ВКонтакте: ${attachments.length} из ${mediaItems.length}.`);
    return attachments;
  };
  publishButton?.addEventListener('click', async () => {
    const message = draft?.value.trim() ?? '';
    const password = passwordInput?.value ?? '';
    if (!approval?.checked || !vkConfigured || message.length < 100 || busy) return;
    let publishAt: number | null = null;
    let confirmation = 'Опубликовать этот пост на вашей личной странице ВКонтакте прямо сейчас?';
    if (selectedMode() === 'scheduled') {
      const date = publishDate?.value ? new Date(publishDate.value) : null;
      if (!date || Number.isNaN(date.getTime()) || date.getTime() < Date.now() + 60_000) return setStatus(publishStatus, 'Выберите дату и время в будущем.', true);
      publishAt = Math.floor(date.getTime() / 1000);
      confirmation = `Поставить пост в очередь ВК на ${date.toLocaleString('ru-RU')}?`;
    }
    if (!window.confirm(confirmation)) return;

    if (isVkMiniApp && vkBridgeReady) {
      setStatus(publishStatus, 'Обновляем разрешение ВКонтакте перед публикацией…');
      try {
        await requestVkAccessToken();
        await checkVkConnection(password);
        if (!vkConfigured || !vkOwnerId) throw new Error('ВКонтакте не подтвердил подключение страницы.');
      } catch (error) {
        return setStatus(publishStatus, russianError(error, 'Не удалось обновить разрешение ВКонтакте. Нажмите «Подключить мою страницу ВК» и повторите.'), true);
      }
    }

    busy = true; updatePublishButton();
    setStatus(publishStatus, mediaItems.length ? 'Сначала загружаем выбранные вложения…' : 'Отправляем одобренный текст во ВКонтакте…');
    let uploadedAttachmentCount = 0;
    let wallRequestStarted = false;
    try {
      const attachments = await uploadMedia(password);
      uploadedAttachmentCount = attachments.length;
      setStatus(publishStatus, publishAt ? 'Ставим пост в очередь ВКонтакте…' : 'Публикуем пост во ВКонтакте…');
      let data: { published?: boolean; scheduled?: boolean; publishAt?: number; url?: string; error?: string };
      if (vkAccessToken && vkBridgeReady && vkOwnerId) {
        const parameters: Record<string, string | number> = {
          owner_id: vkOwnerId,
          message,
          guid: publishRequestId,
        };
        if (attachments.length) parameters.attachments = attachments.join(',');
        if (publishAt) parameters.publish_date = publishAt;
        wallRequestStarted = true;
        const result = await callVkThroughBridge<{ post_id?: number }>('wall.post', parameters);
        if (!result.post_id) throw new Error('ВКонтакте не вернул номер записи.');
        data = {
          published: true,
          scheduled: publishAt !== null,
          publishAt: publishAt ?? undefined,
          url: `https://vk.com/wall${vkOwnerId}_${result.post_id}`,
        };
      } else {
        wallRequestStarted = true;
        const response = await fetch(form?.dataset.publishEndpoint || '/api/owner/publish-vk', {
          method: 'POST',
          headers: ownerHeaders(password, true),
          body: JSON.stringify({ message, attachments, publishAt, approved: true, requestId: publishRequestId }),
        });
        data = await readApiJson<typeof data>(response, 'Не удалось прочитать ответ сервиса публикации.');
        if (!response.ok) throw new Error(data.error || 'Не удалось отправить пост.');
      }
      if (!data.published || !data.url) throw new Error(data.error || 'Не удалось отправить пост.');
      const scheduledDate = data.publishAt ? new Date(data.publishAt * 1000) : null;
      const attachmentNote = uploadedAttachmentCount ? ` Вложения прикреплены: ${uploadedAttachmentCount} из ${mediaItems.length}.` : ' Публикация без вложений.';
      setStatus(publishStatus, (data.scheduled && scheduledDate ? `Пост поставлен в очередь на ${scheduledDate.toLocaleString('ru-RU')}.` : 'Пост опубликован во ВКонтакте.') + attachmentNote);
      if (publishedLink) {
        const link = document.createElement('a');
        link.href = data.url; link.target = '_blank'; link.rel = 'noopener noreferrer';
        link.textContent = data.scheduled ? 'Открыть запись в ВК' : 'Открыть опубликованный пост в ВК';
        publishedLink.replaceChildren(link);
      }
      if (approval) approval.checked = false;
      await saveHistory({
        id: publishRequestId, platform: 'vk',
        title: plantInput?.value.trim().slice(0, 120) || 'Публикация без названия',
        status: data.scheduled ? 'scheduled' : 'published',
        createdAt: new Date().toISOString(),
        ...(data.publishAt ? { scheduledAt: new Date(data.publishAt * 1000).toISOString() } : {}),
        url: data.url,
      });
    } catch (error) {
      const fallback = wallRequestStarted
        ? 'Не удалось получить подтверждение от ВКонтакте. Не нажимайте кнопку повторно: сначала проверьте отложенные записи на своей странице.'
        : 'Не удалось связаться с сервисом публикации. Пост не создан и не поставлен в очередь.';
      const detail = russianError(error, fallback);
      const attachmentNote = uploadedAttachmentCount ? ` Вложения успешно загружены: ${uploadedAttachmentCount} из ${mediaItems.length}.` : '';
      setStatus(publishStatus, `${detail}${attachmentNote}`, true);
      void saveHistory({
        id: publishRequestId, platform: 'vk',
        title: plantInput?.value.trim().slice(0, 120) || 'Публикация без названия',
        status: 'error', createdAt: new Date().toISOString(),
      });
    } finally { busy = false; updatePublishButton(); }
  });

  updateScheduleMinimum();
  void initializeVkMiniApp();
</script>

<style>
  .owner-studio{min-height:70vh;background:var(--paper-2)}
  .studio-wrap{max-width:980px}.studio-heading{max-width:760px;margin-bottom:1.5rem}.studio-heading>p:not(.eyebrow){color:var(--muted)}
  .privacy-note{margin-bottom:1.5rem;padding:1rem 1.2rem;border-left:4px solid var(--honey);background:rgba(255,255,255,.65)}
  .vk-connect-panel{margin-top:1rem;padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--paper-2)}.vk-connect-panel p{margin:.25rem 0 .75rem}
  .studio-card{margin-bottom:1.5rem;padding:clamp(1.2rem,4vw,2.2rem);border:1px solid var(--line);border-radius:var(--radius);background:var(--white);box-shadow:var(--shadow)}
  .studio-step+.studio-step{margin-top:2rem;padding-top:2rem;border-top:1px solid var(--line)}
  .step-number{margin-bottom:.4rem;color:var(--apple);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .studio-step h2{margin-bottom:1rem;font-size:clamp(1.4rem,3vw,2rem)}.studio-step label{display:block;margin:.8rem 0 .45rem;color:var(--forest);font-weight:700}
  .studio-step input[type="text"],.studio-step input[type="password"],.studio-step input[type="datetime-local"],.studio-step textarea{width:100%;padding:.8rem 1rem;border:1px solid var(--line);border-radius:14px;color:var(--ink);background:var(--paper);font:inherit;line-height:1.55}
  .studio-step textarea{resize:vertical}.studio-step input:focus,.studio-step textarea:focus{outline:3px solid rgba(216,168,78,.4);border-color:var(--forest)}
  .field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.field-help,.editor-meta,.draft-source{color:var(--muted);font-size:.82rem}.studio-step .button{margin-top:1rem}
  .studio-status{min-height:1.5em;margin:.8rem 0 0;color:var(--forest)}.studio-status[data-error="true"]{color:var(--apple)}.editor-meta{display:flex;justify-content:space-between;gap:1rem;margin-top:.5rem}
  .button-row{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1rem}.secondary-button,.file-picker,.remove-media{padding:.65rem 1rem;border:1px solid var(--forest);border-radius:999px;color:var(--forest);background:transparent;cursor:pointer;font-weight:700}
  .file-picker{display:inline-block!important;margin-top:.5rem!important}#vk-media{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .media-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-top:1rem}.media-card{overflow:hidden;border:1px solid var(--line);border-radius:14px;background:var(--paper)}
  .media-card img,.media-card video{display:block;width:100%;height:170px;object-fit:cover;background:#111}.media-info{display:flex;flex-direction:column;align-items:flex-start;gap:.35rem;padding:.75rem}.media-info strong{max-width:100%;overflow-wrap:anywhere}.media-info span{color:var(--muted);font-size:.82rem}.remove-media{padding:.35rem .7rem;margin-top:.25rem}
  .publish-mode{display:flex;flex-wrap:wrap;gap:.8rem 1.4rem;margin:1rem 0;padding:1rem;border:1px solid var(--line);border-radius:14px}.publish-mode legend{padding:0 .4rem;color:var(--forest);font-weight:800}.publish-mode label{display:flex!important;align-items:center;gap:.45rem;margin:0!important}
  .approval-row{display:flex!important;align-items:flex-start;gap:.75rem;padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--paper)}.approval-row input{width:1.2rem;height:1.2rem;margin-top:.2rem;flex:0 0 auto}.publish-button:disabled{cursor:not-allowed;opacity:.5;transform:none}
.history-list{margin-top:1rem;overflow-x:auto}.history-table{width:100%;border-collapse:collapse;font-size:.84rem}.history-table th,.history-table td{padding:.75rem .65rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}.history-table th{color:var(--forest);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em}.history-table td[data-history-status=published]{color:var(--forest);font-weight:800}.history-table td[data-history-status=scheduled]{color:#8a641d;font-weight:800}.history-table td[data-history-status=error]{color:var(--apple);font-weight:800}.history-empty{padding:1rem;background:var(--paper);border-radius:14px;color:var(--muted)}
  [hidden]{display:none!important}@media(max-width:720px){.field-grid{grid-template-columns:1fr}.editor-meta{flex-direction:column}.studio-step .button{width:100%}.media-grid{grid-template-columns:1fr}}
</style>
