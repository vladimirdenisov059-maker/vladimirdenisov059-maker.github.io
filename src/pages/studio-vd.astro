---
import BaseLayout from '@/layouts/BaseLayout.astro';

const publicGeneratorUrl = import.meta.env.PUBLIC_GENERATOR_API_URL || '/api/generate-post';
const apiOrigin = publicGeneratorUrl.startsWith('http') ? new URL(publicGeneratorUrl).origin : '';
const draftEndpoint = `${apiOrigin}/api/owner/generate-vk`;
const publishEndpoint = `${apiOrigin}/api/owner/publish-vk`;
---

<BaseLayout title="Редактор Владимира" description="Закрытый редактор авторских публикаций Владимира Денисова.">
  <section class="section owner-studio">
    <div class="wrap studio-wrap">
      <header class="studio-heading">
        <p class="eyebrow">Личный кабинет</p>
        <h1>Редактор постов Владимира</h1>
        <p>Здесь готовится подробный пост для ВКонтакте. Страница не указана в меню, а действия защищены паролем владельца.</p>
      </header>

      <div class="privacy-note" role="note">
        <strong>Как это работает:</strong> сначала создаётся черновик, затем вы исправляете текст и отдельно подтверждаете публикацию. Пароль не сохраняется в браузере, черновик не хранится на сервере.
      </div>

      <form class="studio-card access-card" data-owner-form data-draft-endpoint={draftEndpoint} data-publish-endpoint={publishEndpoint}>
        <section class="studio-step" aria-labelledby="step-access">
          <div class="step-number">Доступ</div>
          <h2 id="step-access">Пароль владельца</h2>
          <label for="owner-password">Введите пароль закрытого редактора</label>
          <input id="owner-password" name="password" type="password" autocomplete="current-password" minlength="12" required />
          <p class="field-help">Пароль проверяется в Cloudflare и не записывается на сайт.</p>
        </section>

        <section class="studio-step" aria-labelledby="step-one">
          <div class="step-number">Шаг 1</div>
          <h2 id="step-one">Создать подробный пост для ВК</h2>
          <div class="field-grid">
            <div>
              <label for="owner-plant">Растение</label>
              <input id="owner-plant" name="plant" type="text" minlength="2" maxlength="80" placeholder="Например: киви Стратона" required />
            </div>
            <div>
              <label for="owner-focus">Главная тема поста</label>
              <input id="owner-focus" name="focus" type="text" maxlength="500" placeholder="Например: первое цветение и история опыта" />
            </div>
          </div>
          <label for="owner-notes">Мои наблюдения, которые обязательно учесть</label>
          <textarea id="owner-notes" name="notes" rows="5" maxlength="3000" placeholder="Добавьте новые факты, которых ещё нет на сайте. Если растение уже подробно описано, поле можно оставить пустым."></textarea>
          <p class="field-help">Эти сведения будут переданы сервису искусственного интеллекта только для создания черновика.</p>
          <button class="button" type="submit" data-generate-button>Создать черновик от моего имени</button>
          <p class="studio-status" data-studio-status aria-live="polite"></p>
        </section>
      </form>

      <section class="studio-card studio-step" data-editor-section hidden aria-labelledby="step-two">
        <div class="step-number">Шаг 2</div>
        <h2 id="step-two">Проверить и исправить</h2>
        <p class="draft-source" data-draft-source></p>
        <label for="vk-draft">Текст поста</label>
        <textarea id="vk-draft" rows="22" maxlength="15000" data-vk-draft></textarea>
        <div class="editor-meta">
          <span data-character-count>0 знаков</span>
          <span>Изменения остаются только на этом устройстве</span>
        </div>
        <div class="button-row">
          <button class="secondary-button" type="button" data-copy-draft>Копировать</button>
          <button class="secondary-button" type="button" data-download-draft>Сохранить как TXT</button>
        </div>
      </section>

      <section class="studio-card studio-step publish-step" data-publish-section hidden aria-labelledby="step-three">
        <div class="step-number">Шаг 3</div>
        <h2 id="step-three">Одобрить и опубликовать</h2>
        <p data-vk-state>Проверяем подключение ВКонтакте…</p>
        <label class="approval-row">
          <input type="checkbox" data-publish-approval />
          <span>Я полностью проверил текст и одобряю его публикацию на моей странице ВКонтакте.</span>
        </label>
        <button class="button publish-button" type="button" data-publish-button disabled>Опубликовать в ВК</button>
        <p class="studio-status" data-publish-status aria-live="polite"></p>
        <p data-published-link></p>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-owner-form]');
  const passwordInput = document.querySelector<HTMLInputElement>('#owner-password');
  const plantInput = document.querySelector<HTMLInputElement>('#owner-plant');
  const focusInput = document.querySelector<HTMLInputElement>('#owner-focus');
  const notesInput = document.querySelector<HTMLTextAreaElement>('#owner-notes');
  const generateButton = document.querySelector<HTMLButtonElement>('[data-generate-button]');
  const status = document.querySelector<HTMLElement>('[data-studio-status]');
  const editorSection = document.querySelector<HTMLElement>('[data-editor-section]');
  const publishSection = document.querySelector<HTMLElement>('[data-publish-section]');
  const draft = document.querySelector<HTMLTextAreaElement>('[data-vk-draft]');
  const draftSource = document.querySelector<HTMLElement>('[data-draft-source]');
  const characterCount = document.querySelector<HTMLElement>('[data-character-count]');
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-draft]');
  const downloadButton = document.querySelector<HTMLButtonElement>('[data-download-draft]');
  const approval = document.querySelector<HTMLInputElement>('[data-publish-approval]');
  const publishButton = document.querySelector<HTMLButtonElement>('[data-publish-button]');
  const publishStatus = document.querySelector<HTMLElement>('[data-publish-status]');
  const vkState = document.querySelector<HTMLElement>('[data-vk-state]');
  const publishedLink = document.querySelector<HTMLElement>('[data-published-link]');

  let vkConfigured = false;
  let publishRequestId = crypto.randomUUID();

  const setStatus = (node: HTMLElement | null, message: string, isError = false) => {
    if (!node) return;
    node.textContent = message;
    node.dataset.error = String(isError);
  };

  const updateCounter = () => {
    if (characterCount) characterCount.textContent = `${draft?.value.length ?? 0} знаков`;
  };

  const updatePublishButton = () => {
    if (!publishButton) return;
    publishButton.disabled = !vkConfigured || !approval?.checked || (draft?.value.trim().length ?? 0) < 100;
  };

  draft?.addEventListener('input', () => {
    updateCounter();
    if (approval) approval.checked = false;
    publishRequestId = crypto.randomUUID();
    updatePublishButton();
    setStatus(publishStatus, 'После исправлений снова отметьте подтверждение.');
    if (publishedLink) publishedLink.replaceChildren();
  });
  approval?.addEventListener('change', updatePublishButton);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const password = passwordInput?.value ?? '';
    const plant = plantInput?.value.trim() ?? '';
    if (password.length < 12) {
      setStatus(status, 'Введите пароль владельца длиной не менее 12 символов.', true);
      passwordInput?.focus();
      return;
    }
    if (plant.length < 2) {
      setStatus(status, 'Введите название растения.', true);
      plantInput?.focus();
      return;
    }

    if (generateButton) {
      generateButton.disabled = true;
      generateButton.textContent = 'Создаём подробный черновик…';
    }
    setStatus(status, 'Собираем ваш опыт и готовим текст для ВКонтакте…');
    if (editorSection) editorSection.hidden = true;
    if (publishSection) publishSection.hidden = true;

    try {
      const response = await fetch(form.dataset.draftEndpoint || '/api/owner/generate-vk', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${password}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ plant, focus: focusInput?.value ?? '', notes: notesInput?.value ?? '' }),
      });
      const data = await response.json() as {
        post?: string;
        error?: string;
        matchedPlant?: string | null;
        vkConfigured?: boolean;
      };
      if (!response.ok || !data.post) throw new Error(data.error || 'Не удалось создать черновик.');

      if (draft) draft.value = data.post;
      if (draftSource) {
        draftSource.textContent = data.matchedPlant
          ? `Использован опубликованный опыт: ${data.matchedPlant}`
          : 'Черновик создан по добавленным вами наблюдениям.';
      }
      vkConfigured = data.vkConfigured === true;
      if (vkState) {
        vkState.textContent = vkConfigured
          ? 'ВКонтакте подключён. После проверки текста подтвердите публикацию.'
          : 'ВКонтакте пока не подключён. Черновик уже можно исправлять, сохранять и копировать.';
      }
      if (approval) approval.checked = false;
      publishRequestId = crypto.randomUUID();
      updateCounter();
      updatePublishButton();
      if (editorSection) editorSection.hidden = false;
      if (publishSection) publishSection.hidden = false;
      setStatus(status, 'Черновик готов. Теперь внимательно проверьте и исправьте его.');
      editorSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (error) {
      setStatus(status, error instanceof Error ? error.message : 'Произошла ошибка.', true);
    } finally {
      if (generateButton) {
        generateButton.disabled = false;
        generateButton.textContent = 'Создать черновик от моего имени';
      }
    }
  });

  copyButton?.addEventListener('click', async () => {
    const text = draft?.value.trim() ?? '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copyButton.textContent = 'Скопировано';
      window.setTimeout(() => { copyButton.textContent = 'Копировать'; }, 1800);
    } catch {
      setStatus(publishStatus, 'Не удалось скопировать автоматически. Выделите текст вручную.', true);
    }
  });

  downloadButton?.addEventListener('click', () => {
    const text = draft?.value.trim() ?? '';
    if (!text) return;
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `post-vk-${new Date().toISOString().slice(0, 10)}.txt`;
    link.click();
    URL.revokeObjectURL(url);
  });

  publishButton?.addEventListener('click', async () => {
    const message = draft?.value.trim() ?? '';
    const password = passwordInput?.value ?? '';
    if (!approval?.checked || !vkConfigured || message.length < 100) return;
    if (!window.confirm('Опубликовать этот текст на вашей странице ВКонтакте прямо сейчас?')) return;

    publishButton.disabled = true;
    publishButton.textContent = 'Публикуем…';
    setStatus(publishStatus, 'Отправляем одобренный текст во ВКонтакте…');
    try {
      const response = await fetch(form?.dataset.publishEndpoint || '/api/owner/publish-vk', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${password}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ message, approved: true, requestId: publishRequestId }),
      });
      const data = await response.json() as { published?: boolean; url?: string; error?: string };
      if (!response.ok || !data.published || !data.url) throw new Error(data.error || 'Не удалось опубликовать пост.');

      setStatus(publishStatus, 'Пост опубликован во ВКонтакте.');
      if (publishedLink) {
        const link = document.createElement('a');
        link.href = data.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Открыть опубликованный пост в ВК';
        publishedLink.replaceChildren(link);
      }
      if (approval) approval.checked = false;
    } catch (error) {
      setStatus(publishStatus, error instanceof Error ? error.message : 'Произошла ошибка публикации.', true);
    } finally {
      publishButton.textContent = 'Опубликовать в ВК';
      updatePublishButton();
    }
  });
</script>

<style>
  .owner-studio{min-height:70vh;background:var(--paper-2)}
  .studio-wrap{max-width:980px}
  .studio-heading{max-width:760px;margin-bottom:1.5rem}
  .studio-heading>p:not(.eyebrow){color:var(--muted)}
  .privacy-note{margin-bottom:1.5rem;padding:1rem 1.2rem;border-left:4px solid var(--honey);background:rgba(255,255,255,.65)}
  .studio-card{margin-bottom:1.5rem;padding:clamp(1.2rem,4vw,2.2rem);border:1px solid var(--line);border-radius:var(--radius);background:var(--white);box-shadow:var(--shadow)}
  .studio-step+.studio-step{margin-top:2rem;padding-top:2rem;border-top:1px solid var(--line)}
  .step-number{margin-bottom:.4rem;color:var(--apple);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .studio-step h2{margin-bottom:1rem;font-size:clamp(1.4rem,3vw,2rem)}
  .studio-step label{display:block;margin:.8rem 0 .45rem;color:var(--forest);font-weight:700}
  .studio-step input[type="text"],.studio-step input[type="password"],.studio-step textarea{width:100%;padding:.8rem 1rem;border:1px solid var(--line);border-radius:14px;color:var(--ink);background:var(--paper);font:inherit;line-height:1.55}
  .studio-step textarea{resize:vertical}
  .studio-step input:focus,.studio-step textarea:focus{outline:3px solid rgba(216,168,78,.4);border-color:var(--forest)}
  .field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .field-help,.editor-meta,.draft-source{color:var(--muted);font-size:.82rem}
  .studio-step .button{margin-top:1rem}
  .studio-status{min-height:1.5em;margin:.8rem 0 0;color:var(--forest)}
  .studio-status[data-error="true"]{color:var(--apple)}
  .editor-meta{display:flex;justify-content:space-between;gap:1rem;margin-top:.5rem}
  .button-row{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1rem}
  .secondary-button{padding:.65rem 1rem;border:1px solid var(--forest);border-radius:999px;color:var(--forest);background:transparent;cursor:pointer;font-weight:700}
  .approval-row{display:flex!important;align-items:flex-start;gap:.75rem;padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--paper)}
  .approval-row input{width:1.2rem;height:1.2rem;margin-top:.2rem;flex:0 0 auto}
  .publish-button:disabled{cursor:not-allowed;opacity:.5;transform:none}
  [hidden]{display:none!important}
  @media(max-width:720px){.field-grid{grid-template-columns:1fr}.editor-meta{flex-direction:column}.studio-step .button{width:100%}}
</style>