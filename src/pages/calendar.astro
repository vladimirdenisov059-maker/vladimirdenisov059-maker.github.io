---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import { gardenTasks } from '@/data/tasks'; const months=['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];
---
<BaseLayout title="Календарь сада" description="Сезонный календарь работ и наблюдений в саду Донбасса."><PageHero eyebrow="Сезон за сезоном" title="Календарь сада" intro="Ориентиры для наблюдений и работ. Конкретные сроки всегда зависят от погоды и состояния растений." note="Календарь не заменяет осмотр сада: весна и осень каждый год приходят по-разному."/><section class="section"><div class="wrap calendar-grid">{months.map((month,index)=>{const tasks=gardenTasks.filter((task)=>task.month===index+1);return <article class:list={['month-card',{'has-tasks':tasks.length}]}><span>{String(index+1).padStart(2,'0')}</span><h2>{month}</h2>{tasks.length?tasks.map((task)=><div class="task"><b>{task.title}</b><p>{task.description}</p><small>{task.category} · {task.priority}</small></div>):<p class="muted">Записи будут добавлены после сверки с авторским календарём.</p>}</article>})}</div></section></BaseLayout>
<style>.calendar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;border:1px solid var(--line);background:var(--line)}.month-card{min-height:260px;padding:1.4rem;background:rgba(255,253,247,.7)}.month-card>span{color:var(--apple);font:600 2rem var(--serif)}.month-card h2{font-size:1.4rem}.month-card.has-tasks{background:var(--white)}.task{margin-top:1rem;padding-top:1rem;border-top:1px solid var(--line)}.task p{margin:.3rem 0;color:var(--muted);font-size:.85rem}.task small{color:var(--apple)}.muted{color:var(--muted);font-size:.82rem}@media(max-width:850px){.calendar-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.calendar-grid{grid-template-columns:1fr}}</style>
