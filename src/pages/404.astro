---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Страница не найдена"><section class="not-found"><div class="wrap"><span>404</span><p class="eyebrow">Такой грядки нет</p><h1>Страница не найдена</h1><p class="lead">Возможно, адрес изменился или материал ещё только готовится к публикации.</p><a class="button" href="/">Вернуться в сад</a></div></section></BaseLayout><style>.not-found{min-height:65vh;display:grid;place-items:center;padding:4rem 0;text-align:center}.not-found span{display:block;color:var(--paper-2);font:600 clamp(7rem,25vw,18rem) var(--serif);line-height:.6;text-shadow:0 0 1px var(--forest)}.not-found .lead{margin:0 auto 2rem}</style>
