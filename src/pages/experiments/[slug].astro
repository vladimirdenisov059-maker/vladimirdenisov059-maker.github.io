---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import { experiments } from '@/data/experiments';
export function getStaticPaths(){return experiments.map((experiment)=>({params:{slug:experiment.slug},props:{experiment}}));} const {experiment}=Astro.props;
---
<BaseLayout title={experiment.title} description={experiment.summary}><Breadcrumbs items={[{label:'Главная',href:'/'},{label:'Эксперименты',href:'/experiments/'},{label:experiment.title}]}/><section class="page-hero"><div class="wrap"><p class="eyebrow">{experiment.status} · дневник эксперимента</p><h1>{experiment.title}</h1><p class="lead">{experiment.summary}</p></div></section><section class="section"><div class="wrap experiment-layout"><div><h2>Временная шкала</h2><div class="timeline">{experiment.timeline.map((entry)=><article class="timeline-entry"><span class="timeline-year">{entry.year}</span><h3>{entry.title}</h3><p>{entry.description}</p>{entry.result&&<p><strong>Результат:</strong> {entry.result}</p>}</article>)}</div></div><aside><div class="article-aside"><h2>Цель</h2><p>{experiment.goal}</p><h2>Следующие шаги</h2><ul>{experiment.nextSteps.map((item)=><li>{item}</li>)}</ul></div></aside></div></section><section class="section section--line"><div class="wrap"><h2>Фото и видео эксперимента</h2><div class="experiment-media">{experiment.images.map((src)=><img src={src} alt={`${experiment.title}: авторская фотография`} loading="lazy"/>)}{experiment.videos?.map((video)=><figure><video controls preload="metadata" poster={video.poster}><source src={video.src} type="video/mp4"/>Ваш браузер не поддерживает видео.</video><figcaption>{video.title}</figcaption></figure>)}</div></div></section><section class="section section--line"><div class="wrap result-grid"><div><p class="eyebrow">Что наблюдали</p><ul>{experiment.observations.map((item)=><li>{item}</li>)}</ul></div><div><p class="eyebrow">Что получилось</p>{experiment.results.length?<ul>{experiment.results.map((item)=><li>{item}</li>)}</ul>:<p>Итог ещё не зафиксирован.</p>}</div><div><p class="eyebrow">Ограничения</p><ul>{experiment.problems.map((item)=><li>{item}</li>)}</ul></div></div></section></BaseLayout>
<style>.experiment-layout{display:grid;grid-template-columns:1.5fr .7fr;gap:clamp(2rem,8vw,8rem)}.experiment-media{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin-top:1.5rem}.experiment-media img,.experiment-media video{display:block;width:100%;max-height:620px;object-fit:contain;background:#102b20;border-radius:var(--radius)}.experiment-media figure{margin:0}.experiment-media figcaption{margin-top:.5rem;color:var(--muted);font-size:.85rem}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.result-grid li{margin:.5rem 0}@media(max-width:760px){.experiment-layout,.result-grid,.experiment-media{grid-template-columns:1fr}}</style>
