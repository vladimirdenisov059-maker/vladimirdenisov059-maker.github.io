---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import { site } from '@/config/site';
---
<BaseLayout title="Контакты" description="Публичные страницы Владимира Денисова и сведения о связи с автором проекта."><PageHero eyebrow="Связь с автором" title="Контакты" intro="Пока основными каналами связи остаются публичные страницы Владимира в социальных сетях."/><section class="section"><div class="wrap contact-grid">{site.social.map((item)=><a class="contact-card" href={item.url} target="_blank" rel="noopener"><span>Социальная сеть</span><h2>{item.label}</h2><b>Открыть страницу →</b></a>)}</div><div class="wrap"><div class="notice contact-note"><strong>Форма обратной связи не подключена</strong>Она появится только после выбора обработчика, защиты от спама и утверждения политики персональных данных.</div></div></section></BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.contact-card{display:block;padding:2rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--white);text-decoration:none}.contact-card:hover{box-shadow:var(--shadow)}.contact-card span{color:var(--muted);font-size:.7rem;text-transform:uppercase}.contact-card h2{margin:.6rem 0 2rem}.contact-card b{color:var(--apple);font-size:.85rem}.contact-note{margin-top:2rem}@media(max-width:700px){.contact-grid{grid-template-columns:1fr}}</style>
