---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import PhotoPlaceholder from '@/components/PhotoPlaceholder.astro'; import { plants } from '@/data/plants';
export function getStaticPaths(){return plants.map((plant)=>({params:{slug:plant.slug},props:{plant}}));}
const {plant}=Astro.props;
const facts=[['Категория',plant.category],['Статус',plant.status],['В саду',plant.yearsInGarden?`более ${plant.yearsInGarden} лет`:'уточняется'],['Опыление',plant.pollination??'уточняется'],['Плодоношение',plant.yield??'данные не оцифрованы'],['Зимовка',plant.winterHardiness??'наблюдения готовятся']];
---
<BaseLayout title={plant.name} description={plant.description}><Breadcrumbs items={[{label:'Главная',href:'/'},{label:'Растения',href:'/plants/'},{label:plant.name}]}/><section class="section plant-head"><div class="wrap plant-head-grid"><div><p class="eyebrow">{plant.category} · {plant.status}</p><h1>{plant.name}</h1>{plant.latinName&&<p class="latin">{plant.latinName}</p>}<p class="lead">{plant.description}</p></div><PhotoPlaceholder ratio="portrait" label={`Фотография: ${plant.name}`} image={plant.images[0]} alt={plant.images[0]?plant.name:''}/></div></section><section class="section section--line"><div class="wrap article-layout"><div><h2>Что известно</h2><p class="prose-intro">{plant.personalNotes}</p><dl class="facts">{facts.map(([term,value])=><div class="fact"><dt>{term}</dt><dd>{value}</dd></div>)}</dl><div class="two-cols"><div><h2>Сильные стороны</h2><ul>{plant.advantages.map((item)=><li>{item}</li>)}</ul></div><div><h2>Ограничения</h2><ul>{plant.disadvantages.map((item)=><li>{item}</li>)}</ul></div></div><h2>Фото и видео</h2>{plant.videos?.length?<div class="plant-videos">{plant.videos.map((video)=><figure><video controls preload="metadata" poster={video.poster}><source src={video.src} type="video/mp4"/>Ваш браузер не поддерживает видео.</video><figcaption>{video.title}</figcaption></figure>)}</div>:<div class="empty-state"><p>Здесь появятся авторские видео с датами, подписями и этапами развития.</p></div>}</div><aside class="article-aside"><h2>Нужно подтвердить</h2>{plant.confirmationNeeded?.length?<ul>{plant.confirmationNeeded.map((item)=><li>{item}</li>)}</ul>:<p>Основные сведения зафиксированы; ожидаются фотографии.</p>}<p class="notice">Карточка не заменяет региональную агротехническую рекомендацию.</p></aside></div></section></BaseLayout>
<style>.plant-head{padding-top:3rem}.plant-head-grid{display:grid;grid-template-columns:1.2fr .65fr;gap:clamp(2rem,7vw,7rem);align-items:center}.plant-head h1{font-size:clamp(2.8rem,7vw,6rem)}.latin{color:var(--leaf);font:italic 1.2rem var(--serif)}.two-cols{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin:3rem 0}.two-cols li{margin:.5rem 0}.plant-videos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin-top:1.5rem}.plant-videos figure{margin:0}.plant-videos video{display:block;width:100%;max-height:680px;object-fit:contain;background:#102b20;border-radius:var(--radius)}.plant-videos figcaption{margin-top:.6rem;color:var(--muted);font-size:.85rem}@media(max-width:750px){.plant-head-grid,.two-cols,.plant-videos{grid-template-columns:1fr}.plant-head .photo{max-width:420px}}</style>
