# Публичный адрес сайта после выбора домена
PUBLIC_SITE_URL=https://example.com
# ID Яндекс Метрики добавлять только после согласования политики cookies
PUBLIC_YANDEX_METRIKA_ID=
# URL обработчика формы — не требуется для статической первой версии
PUBLIC_CONTACT_FORM_ENDPOINT=
# Секрет PROXYAPI_KEY здесь не хранить: добавьте его как encrypted secret в Cloudflare Pages.

# Публичный адрес отдельного Cloudflare Pages API-шлюза
PUBLIC_GENERATOR_API_URL=https://gardens-of-donbas-api.pages.dev/api/generate-post

# Секреты закрытого редактора хранятся только в Cloudflare Pages:
# ADMIN_PASSWORD — пароль владельца (encrypted secret)
# VK_ACCESS_TOKEN — токен ВКонтакте (encrypted secret, подключается позже)
# VK_OWNER_ID — числовой ID личной страницы или отрицательный ID сообщества
# VK_API_VERSION=5.199
# OK_APPLICATION_KEY, OK_APPLICATION_SECRET_KEY, OK_ACCESS_TOKEN — доступ к API Одноклассников (encrypted secrets)
# OK_GROUP_ID — числовой ID группы ОК, куда публикуются записи
